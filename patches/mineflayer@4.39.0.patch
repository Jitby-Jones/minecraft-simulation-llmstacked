+// The entity_action enum was renumbered in 1.21.6 (the shift-key actions moved to player_input). When the
+// protocol declares a name mapper for actionId, write the action name so protodef emits the right id for this
+// version; otherwise fall back to the legacy numeric id.
+function entityActionId (bot, name, legacyId) {
+  try {
+    const t = bot.registry.protocol.play.toServer.types.packet_entity_action
