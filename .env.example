# NanoGPT API key. Set the key's billing mode to "Subscription only" in the NanoGPT dashboard (DESIGN.md §22.1).
NANOGPT_API_KEY=

# Optional: where all mutable state lives (server, agents, graveyard, logs, cache). Default: ./data
DATA_DIR=

# Optional: the RCON password, also the token `pnpm ctl` uses with the dashboard's control endpoint. Generated
# into .env by `pnpm run setup` if empty.
RCON_PASSWORD=

# Docker only (deploy/compose.yaml): set to true once you have read and accept the Minecraft EULA
# (https://aka.ms/MinecraftEULA); the container's setup then accepts it for the server.
AGORA_ACCEPT_EULA=
